# OmniRetail Data Platform — local configuration template.
# Copy to .env and adjust values. Never commit .env to Git.

COMPOSE_PROJECT_NAME=omni-retail

# MinIO (S3-compatible object storage; used from Phase 1)
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# Ingestion S3 access (Phase 3): least-privilege MinIO user `omni-ingestion`,
# created by infrastructure/scripts/minio_init.sh (rw: landing/archive/rejected,
# read-only: lakehouse). S3_ENDPOINT_URL defaults to http://127.0.0.1:9000.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=change-me-ingestion-key
S3_SECRET_ACCESS_KEY=change-me-ingestion-secret

# Mock external API (Phase 3): deterministic FastAPI service with fault
# injection (docs/adr/0002-mock-api-service.md). MOCK_API_BASE_URL is used by
# the ingestion clients; MOCK_API_PORT is the host port of the compose service;
# MOCK_API_SEED drives deterministic data generation.
MOCK_API_BASE_URL=http://127.0.0.1:9002
MOCK_API_PORT=9002
MOCK_API_SEED=42

# PostgreSQL (OLTP source; used from Phase 1)
POSTGRES_USER=change-me-postgres-user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=omni_oltp
# Optional overrides for the OLTP generator (defaults: localhost / 5432)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Trino (analytical SQL engine over Iceberg; used from Phase 5). The Bronze
# loader and dbt connect from the host by default; inside the Docker network
# the Airflow services override this to `trino` in docker-compose.yml
# (x-airflow-env, Phase 5 slice 3) — keep 127.0.0.1 here for local CLI runs.
TRINO_HOST=127.0.0.1
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_USER=omni

# Lakehouse schema overrides. Production defaults are unchanged; integration
# tests replace all five values with disposable UUID-prefixed schemas.
ICEBERG_BRONZE_SCHEMA=bronze
DBT_BRONZE_SCHEMA=bronze
DBT_SILVER_SCHEMA=silver
DBT_GOLD_SCHEMA=gold
DBT_ANALYTICS_SCHEMA=analytics

# PostgreSQL for Polaris catalog metadata (internal, no host port)
POLARIS_POSTGRES_USER=change-me-polaris-pg-user
POLARIS_POSTGRES_PASSWORD=change-me-polaris-pg-password
POLARIS_POSTGRES_DB=polaris_metadata

# Apache Polaris (Iceberg REST catalog)
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=change-me-polaris-secret

# Airflow orchestration (Phase 4; profile `orchestration`, ADR 0003).
# FERNET key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=change-me-fernet-key
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=change-me-airflow-password
AIRFLOW_WEBSERVER_PORT=8081
AIRFLOW_POSTGRES_USER=change-me-airflow-pg-user
AIRFLOW_POSTGRES_PASSWORD=change-me-airflow-pg-password
AIRFLOW_POSTGRES_DB=airflow_metadata

# ClickHouse serving layer (Phase 6; compose profile `bi`, ADR 0004).
# CLICKHOUSE_HOST/PORT point host-side CLI and tests at the HTTP interface
# (the native port 9000 is not published — MinIO owns host 9000);
# CLICKHOUSE_HTTP_PORT is the host port mapping in docker-compose.yml.
# Service accounts are created by clickhouse-init from clickhouse/migrations:
# omni_publisher (full grants on analytics.*) and superset_reader
# (SELECT-only; used by Superset from Phase 7).
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_ADMIN_PASSWORD=change-me-clickhouse-admin-password
CLICKHOUSE_PUBLISHER_USER=omni_publisher
CLICKHOUSE_PUBLISHER_PASSWORD=change-me-clickhouse-publisher-password
CLICKHOUSE_READER_USER=superset_reader
CLICKHOUSE_READER_PASSWORD=change-me-clickhouse-reader-password

# Apache Superset (Phase 7; compose profile `bi`, ADR 0005). SUPERSET_PORT is
# the loopback host port of the web UI. SECRET_KEY signs sessions and
# connection passwords — generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The metadata DB creds stay Docker-network-internal (no host port). The
# admin account is created/updated by superset-init on every `make bi-up`.
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-superset-secret-key
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin-password
SUPERSET_POSTGRES_USER=change-me-superset-pg-user
SUPERSET_POSTGRES_PASSWORD=change-me-superset-pg-password
SUPERSET_POSTGRES_DB=superset_metadata
